              "  gateAssignmentId: 'GATE-ORD-B14',",
              "  inspectorPhone: '+1 (773) 555-0162',",
              "  inspectorEmail: 'chief.inspector@aero-mro.aero',",
              "  faultDetectedUtc: staleTimestamp",
              "});",
              "const secret = pm.collectionVariables.get('hmacSecret') || 'AERO_MRO_HMAC_SECRET_2026';",
              "const signature = CryptoJS.HmacSHA256(payload, secret).toString(CryptoJS.enc.Hex);",
              "pm.environment.set('computedSignature', signature);",
              "pm.environment.set('requestBody', payload);"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 403 Forbidden', function () {",
              "  pm.response.to.have.status(403);",
              "});",
              "pm.test('Error classification is REPLAY_WINDOW_VIOLATION', function () {",
              "  const json = pm.response.json();",
              "  pm.expect(json.error).to.eql('REPLAY_WINDOW_VIOLATION');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-mro-signature-sha256", "value": "{{computedSignature}}" },
          { "key": "x-mro-timestamp", "value": "{{staleTimestamp}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{requestBody}}"
        },
        "url": {
          "raw": "{{webhookUrl}}",
          "host": ["{{webhookUrl}}"]
        }
      }
    },
